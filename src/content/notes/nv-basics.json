{
  "topic": "nv-basics",
  "summary": "「計算の基礎」は、ほかの分野を解くための土台になるウォームアップです。分数・小数・%の行き来、「〜の何%」、比、分数の計算が出ます。電卓は使えないので、紙の上で速く正確に計算できるようにしましょう。",
  "keyPoints": [
    "分数・小数・%は、同じ大きさの別の書き方です。{{1/2}} = 0.5 = 50%",
    "「54人は360人の何%」は、「の」の前の360人が、もとにする量（100%にあたる数）です。",
    "比は、両方に同じ数をかけても、割っても変わりません。",
    "分数の足し算・引き算は、まず通分（分母をそろえること）します。"
  ],
  "formulas": [
    {
      "label": "分数・小数・%の対応（暗記）",
      "body": "{{1/2}} = 0.5 = 50%、{{1/4}} = 0.25 = 25%、{{3/4}} = 0.75 = 75%、{{1/5}} = 0.2 = 20%、{{1/10}} = 0.1 = 10%、{{1/20}} = 0.05 = 5%、{{1/8}} = 0.125 = 12.5%",
      "example": "{{3/8}} は {{1/8}} の3つ分 → 12.5% × 3 = 37.5%"
    },
    {
      "label": "割合の3つの式",
      "body": "比べる量 = もとにする量 × 割合、割合 = 比べる量 ÷ もとにする量、もとにする量 = 比べる量 ÷ 割合",
      "example": "80人の25% → 80 × 0.25 = 20人。20人は80人の何%か → 20 ÷ 80 = 0.25 = 25%"
    },
    {
      "label": "歩合（割・分・厘）",
      "body": "1割 = 10%、1分 = 1%、1厘 = 0.1%",
      "example": "3割5分 = 30% + 5% = 35%。反対に、63% = 6割3分"
    },
    {
      "label": "小数の比・分数の比を簡単にする",
      "body": "小数の比は、両方を10倍して整数にします。分数の比は、分母の最小公倍数（どちらの分母でも割り切れる、いちばん小さい数）を両方にかけます。",
      "example": "0.6:0.9 → 10倍して 6:9 → 3で割って 2:3。{{1/2}}:{{1/3}} → 6倍して 3:2"
    },
    {
      "label": "比の値（AはBの何倍か）",
      "body": "A ÷ B を分数にして、約分します。",
      "example": "12:20 のとき、12 ÷ 20 = {{3/5}} 倍"
    },
    {
      "label": "分数のかけ算・わり算",
      "body": "かけ算は、分子どうし・分母どうしをかけます。わり算は、わる数の分母と分子を入れかえて、かけ算にします。",
      "example": "{{2/5}} × {{5/12}} = {{10/60}} = {{1/6}}。{{3/4}} ÷ {{9/10}} = {{3/4}} × {{10/9}} = {{30/36}} = {{5/6}}"
    }
  ],
  "patterns": [
    {
      "title": "分数・小数・%を行き来する",
      "lead": "分数・小数・%を、たがいに直す問題です。分母を100にそろえるのがコツです。",
      "example": {
        "stem": "{{7/20}} を、小数と百分率（%）で表すと、それぞれいくつか。",
        "figure": {
          "type": "table",
          "table": {
            "headers": ["分数", "小数", "%"],
            "rows": [
              ["{{1/2}}", "0.5", "50%"],
              ["{{1/4}}", "0.25", "25%"],
              ["{{1/5}}", "0.2", "20%"],
              ["{{1/10}}", "0.1", "10%"],
              ["{{1/20}}", "0.05", "5%"],
              ["{{1/8}}", "0.125", "12.5%"]
            ]
          },
          "highlight": [[4, 0], [4, 1], [4, 2]],
          "caption": "よく出る対応表。覚えておくと速くなります。"
        },
        "steps": [
          {
            "text": "分数を小数や%にするには、分母を100（または10、1000）にそろえます。20を100にするには5倍するので、分子も同じ5倍にします。",
            "calc": "7 × 5 = 35、20 × 5 = 100",
            "figure": {
              "type": "flow",
              "items": [
                { "title": "{{7/20}}", "lines": ["分母 20"] },
                "×5",
                { "title": "{{35/100}}", "lines": ["分母 100"], "tone": "ok" }
              ],
              "caption": "分子も分母も5倍にします。"
            }
          },
          {
            "text": "100分の35は、そのまま35%です。%は「100分のいくつか」を表す書き方だからです。",
            "calc": "{{35/100}} = 35%"
          },
          {
            "text": "小数にするには、%を100で割ります（小数点を左に2つ動かします）。",
            "calc": "35 ÷ 100 = 0.35"
          },
          {
            "text": "反対に、小数や%を分数にもどすときは、100を分母にして約分します。35も100も、5で割れます。",
            "calc": "35 ÷ 5 = 7、100 ÷ 5 = 20"
          },
          {
            "text": "表を覚えていれば、{{1/20}} が5%なので、その7つ分としても求められます。",
            "calc": "5% × 7 = 35%"
          }
        ],
        "answer": "0.35、35%"
      },
      "point": "分子に小数点があるとき（12.5%など）は、分子と分母を10倍して整数にそろえてから約分します。"
    },
    {
      "title": "「Xのy%」を求める（歩合も同じ）",
      "lead": "「800円の35%」のように、ある数の何%分かを求める問題です。歩合（割・分）で出たら、まず%に直します。",
      "example": {
        "stem": "800円の3割5分は、何円か。",
        "figure": {
          "type": "tape",
          "rows": [
            {
              "label": "800円（100%）",
              "segments": [
                { "text": "3割5分（?円）", "size": 35, "tone": "ok" },
                { "text": "残り 65%", "size": 65, "tone": "muted" }
              ],
              "total": "800円"
            }
          ]
        },
        "steps": [
          {
            "text": "歩合を%に直します。1割は10%、1分は1%なので、3割5分は、30%と5%を合わせたものです。",
            "calc": "30% + 5% = 35%",
            "figure": {
              "type": "table",
              "table": {
                "headers": ["歩合", "割合", "%"],
                "rows": [
                  ["1割", "0.1", "10%"],
                  ["1分", "0.01", "1%"],
                  ["1厘", "0.001", "0.1%"]
                ]
              },
              "highlight": [[0, 2], [1, 2]]
            }
          },
          {
            "text": "35%は5の倍数なので、まず5%分を求めます。5%は、全体を20等分した1つ分です。",
            "calc": "800 ÷ 20 = 40円"
          },
          {
            "text": "35%は、5%の何個分でしょうか。",
            "calc": "35 ÷ 5 = 7個分"
          },
          {
            "text": "5%分（40円）を7個分たします。",
            "calc": "40 × 7 = 280円",
            "figure": {
              "type": "tape",
              "rows": [
                {
                  "label": "800円（100%）",
                  "segments": [
                    { "text": "35%（280円）", "size": 35, "tone": "ok" },
                    { "text": "残り 65%（520円）", "size": 65, "tone": "muted" }
                  ],
                  "total": "800円"
                }
              ]
            }
          }
        ],
        "answer": "280円"
      },
      "point": "5の倍数の%は、「5%分を出して、何個分かをかける」と暗算できます。"
    },
    {
      "title": "「AはBの何%か」を求める",
      "lead": "2つの数を比べて、割合（%）を求める問題です。どちらがもとにする量かを、まず決めます。",
      "example": {
        "stem": "54人は、360人の何%か。",
        "figure": {
          "type": "tape",
          "rows": [
            {
              "label": "もとにする量",
              "segments": [{ "text": "360人（100%）", "size": 100, "tone": "base" }]
            },
            {
              "label": "比べる量",
              "segments": [
                { "text": "54人", "size": 15, "tone": "ok" },
                { "text": "残り", "size": 85, "tone": "muted" }
              ],
              "total": "?%"
            }
          ]
        },
        "steps": [
          {
            "text": "「360人の何%」の、「の」の前にある360人が、もとにする量（100%にあたる数）です。54人は、比べる量です。"
          },
          {
            "text": "割合は、比べる量 ÷ もとにする量 で求めます。まず分数にします。",
            "calc": "54 ÷ 360 = {{54/360}}"
          },
          {
            "text": "54と360は、どちらも18で割れます。約分します。",
            "calc": "54 ÷ 18 = 3、360 ÷ 18 = 20"
