          {
            "text": "{{3/5}} は「全体を5つに分けた3つ分」という意味です。3つ分が288人なので、まず1つ分を求めます。",
            "calc": "288 ÷ 3 = 96人"
          },
          {
            "text": "全体は5つ分です。1つ分の5倍にします。",
            "calc": "96 × 5 = 480人",
            "figure": {
              "type": "tape",
              "rows": [
                {
                  "label": "全体を5つに分ける",
                  "segments": [
                    { "text": "96人", "size": 1, "tone": "base" },
                    { "text": "96人", "size": 1, "tone": "base" },
                    { "text": "96人", "size": 1, "tone": "base" },
                    { "text": "96人", "size": 1, "tone": "muted" },
                    { "text": "96人", "size": 1, "tone": "muted" }
                  ],
                  "total": "全体 480人"
                }
              ],
              "caption": "左の3つ分が288人です。"
            }
          },
          {
            "text": "確かめます。480人の60%が、288人になれば正解です。",
            "calc": "480 × 0.6 = 288人"
          }
        ],
        "answer": "480人"
